# Config fragment merged on top of arm64 defconfig for every build in this course.
#
# Each block below is here because a specific lecture needs it, and the lecture that needs it is
# named. Nothing is enabled speculatively: a reader who wonders why the kernel has a given
# feature should be able to find the lecture that asked for it.

# The target will not boot without these, and kernel/trim.config turns off whole subsystems by
# name. Listing them here means a trim that goes too far fails loudly at configure time, in
# ci/kernel.sh's check, rather than as a kernel that builds and then hangs with no console.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_ARM_GIC_V3=y
CONFIG_KALLSYMS=y

# L04. Out-of-tree modules, and the version check that makes loading one into the wrong kernel
# an error message rather than a crash.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODVERSIONS=y

# L04, L05. printk's dynamic debug, so pr_debug can be switched on at runtime rather than at
# compile time; and debugfs, which is where a driver puts what is not a stable ABI.
CONFIG_DYNAMIC_DEBUG=y
CONFIG_DEBUG_FS=y

# L05. KUnit, built as a module so a lecture's suite loads and runs without a reboot.
CONFIG_KUNIT=m
CONFIG_KUNIT_DEBUGFS=y

# L07. The lock validator. It is the point of one of L07's exercises, and it costs enough
# performance that a production kernel would not have it; that contrast is part of the lecture.
# It is also on while L12 measures latency, which L07's own rule warns against: L12's B.5 says
# so, and every figure it publishes carries this bookkeeping on both kernels.
CONFIG_PROVE_LOCKING=y
CONFIG_DEBUG_ATOMIC_SLEEP=y

# L10. The device tree. The runtime view of it lives under /sys/firmware/devicetree, with
# /proc/device-tree as a symlink to it; there is no separate config symbol for that any more,
# which is worth knowing because a good deal of writing on the web still names
# CONFIG_PROC_DEVICETREE.
CONFIG_OF=y

# L11. The two frameworks the final lab registers qa-dev with.
#
# GPIO_CDEV, not GPIO_SYSFS. The sysfs interface under /sys/class/gpio is the legacy one; it is
# deprecated, it is hidden behind EXPERT, and libgpiod does not use it. The character device is
# what a current userspace talks to, so it is what the lecture teaches.
CONFIG_GPIOLIB=y
CONFIG_GPIO_CDEV=y
CONFIG_IIO=m
CONFIG_IIO_BUFFER=y
CONFIG_IIO_KFIFO_BUF=m

# L12. Enough tracing to see where latency went. High-resolution timers are what cyclictest
# measures against.
CONFIG_HIGH_RES_TIMERS=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_IRQSOFF_TRACER=y
CONFIG_PREEMPT_TRACER=y
CONFIG_SCHED_TRACER=y
