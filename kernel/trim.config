# Config fragment that removes what this course's target will never have.
#
# This exists because of a number worth knowing before you build anything: arm64 `defconfig` is
# a configuration for every arm64 machine anyone has upstreamed, and building it takes about an
# hour and produces something like two thousand modules. Almost none of them can ever load here.
# The target is one emulated machine with one serial port, one timer, one interrupt controller
# and one made-up device on a platform bus. It has no graphics card, no wireless, no Mellanox
# network adapter and no webcam.
#
# So this fragment turns off the large driver classes wholesale. Each `# CONFIG_X is not set`
# below takes hundreds of files out of the build through the `depends on` lines that hang off
# it, which is Kconfig's whole point and is worth watching happen. L03's lab measures exactly
# this: build with and without one of these lines and see what it cost.
#
# The rule for what belongs here: if the emulated machine cannot physically have it, it goes.
# If the course teaches it, it stays, even when the target does not have one; the I2C and SPI
# cores stay for that reason, because L11 talks about them and a reader should be able to look
# at /sys/bus/i2c even when nothing is on it.

# Graphics, sound and media. The target's only output device is a serial port.
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_SOUND is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_VGA_ARB is not set

# Networking hardware. The kernel keeps its network stack, because /proc/net is worth looking at
# in L02 and because turning the stack off breaks more than it saves; what goes is every vendor's
# driver for hardware that is not here.
# CONFIG_ETHERNET is not set
# CONFIG_WLAN is not set
# CONFIG_WIRELESS is not set
# CONFIG_BT is not set
# CONFIG_INFINIBAND is not set
# CONFIG_CAN is not set
# CONFIG_NET_VENDOR_MELLANOX is not set
# CONFIG_NET_VENDOR_INTEL is not set
# CONFIG_NET_VENDOR_BROADCOM is not set

# Storage. The root filesystem is an initramfs held in RAM, so there is no disk to find.
# CONFIG_SCSI is not set
# CONFIG_ATA is not set
# CONFIG_MD is not set
# CONFIG_MMC is not set
# CONFIG_NVME_CORE is not set

# Buses and device classes with nothing on them.
# CONFIG_USB_SUPPORT is not set
# CONFIG_HID is not set
# CONFIG_INPUT_KEYBOARD is not set
# CONFIG_INPUT_MOUSE is not set
# CONFIG_MTD is not set
# CONFIG_PCI is not set

# Filesystems. An initramfs is a cpio archive unpacked into a tmpfs; none of these are reachable.
# CONFIG_BTRFS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_F2FS_FS is not set
# CONFIG_OCFS2_FS is not set
# CONFIG_NFS_FS is not set
# CONFIG_NFSD is not set
# CONFIG_CEPH_FS is not set

# DWARF for the whole kernel roughly doubles the build time and adds hundreds of megabytes, and
# nothing in this course reads it. An oops is decoded from kallsyms, which stays on, and L04's
# appendix says so where a reader would otherwise expect to need a debugger.
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF5 is not set

# Compressing modules costs build time and buys space this target does not care about. The gate
# is MODULE_COMPRESS itself; the per-algorithm symbols only exist once it is on.
# CONFIG_MODULE_COMPRESS is not set

# Every SoC platform family arm64 defconfig turns on. This is the single biggest thing in the
# build and the least obvious: `defconfig` is not a minimal configuration, it is the union of
# every arm64 machine anyone has upstreamed, so it compiles clock, pinctrl, DMA and PHY drivers
# for forty-four vendors' silicon. QEMU's `virt` machine is none of them. It is built out of
# generic pieces only: a PL011 for the console, a GICv3, the architected timer, and PSCI, and
# not one of those is behind an ARCH_ symbol.
#
# There are 44 of them, listed rather than globbed, because a reader should be able to see
# what was removed and put one back to find out what it was worth.
# CONFIG_ARCH_ACTIONS is not set
# CONFIG_ARCH_AIROHA is not set
# CONFIG_ARCH_ALPINE is not set
# CONFIG_ARCH_APPLE is not set
# CONFIG_ARCH_BCM2835 is not set
# CONFIG_ARCH_BCMBCA is not set
# CONFIG_ARCH_BCM_IPROC is not set
# CONFIG_ARCH_BERLIN is not set
# CONFIG_ARCH_BITMAIN is not set
# CONFIG_ARCH_BRCMSTB is not set
# CONFIG_ARCH_EXYNOS is not set
# CONFIG_ARCH_HISI is not set
# CONFIG_ARCH_INTEL_SOCFPGA is not set
# CONFIG_ARCH_K3 is not set
# CONFIG_ARCH_KEEMBAY is not set
# CONFIG_ARCH_LAYERSCAPE is not set
# CONFIG_ARCH_LG1K is not set
# CONFIG_ARCH_MA35 is not set
# CONFIG_ARCH_MEDIATEK is not set
# CONFIG_ARCH_MESON is not set
# CONFIG_ARCH_MVEBU is not set
# CONFIG_ARCH_MXC is not set
# CONFIG_ARCH_NPCM is not set
# CONFIG_ARCH_PENSANDO is not set
# CONFIG_ARCH_QCOM is not set
# CONFIG_ARCH_REALTEK is not set
# CONFIG_ARCH_RENESAS is not set
# CONFIG_ARCH_ROCKCHIP is not set
# CONFIG_ARCH_S32 is not set
# CONFIG_ARCH_SEATTLE is not set
# CONFIG_ARCH_SPARX5 is not set
# CONFIG_ARCH_SPRD is not set
# CONFIG_ARCH_STM32 is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_SYNQUACER is not set
# CONFIG_ARCH_TEGRA is not set
# CONFIG_ARCH_TESLA_FSD is not set
# CONFIG_ARCH_THUNDER is not set
# CONFIG_ARCH_THUNDER2 is not set
# CONFIG_ARCH_UNIPHIER is not set
# CONFIG_ARCH_VEXPRESS is not set
# CONFIG_ARCH_VISCONTI is not set
# CONFIG_ARCH_XGENE is not set
# CONFIG_ARCH_ZYNQMP is not set
