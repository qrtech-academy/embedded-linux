# Config fragment for the real-time kernel, merged on top of kernel/qa.config by "make kernel RT=1".
#
# Since 6.12 this is all it takes. PREEMPT_RT was merged into mainline in that release; before
# it, a real-time kernel meant an out-of-tree patch series that trailed the kernel it patched by
# weeks and sometimes did not exist at all for a given version. L12 makes that point, and this
# four-line file is the evidence for it.
# PREEMPT_RT is declared "depends on EXPERT && ARCH_SUPPORTS_RT". arm64 selects the second, but
# EXPERT is off in defconfig, so without the line below the symbol has no prompt, is never
# offered, and CONFIG_PREEMPT_RT=y is silently discarded by olddefconfig. The result builds
# cleanly and is not a real-time kernel, which is the worst possible outcome for L12.
#
# This is the same mechanism L03's exercises make you work through with GPIO_SYSFS, and it caught
# this course out in exactly the way that exercise describes. ci/kernel.sh's post-merge check is
# what noticed; without it the first evidence would have been latency numbers that made no sense.
CONFIG_EXPERT=y
CONFIG_PREEMPT_RT=y

# Under PREEMPT_RT almost every spinlock becomes a sleeping lock, and the lock validator is how
# a driver that assumed otherwise announces itself. Left on deliberately: L12's lab wants the
# splat, not a silent hang. The cost is that L12 measures latency on a validating kernel, which
# is what its B.5 says the published figures include, on this kernel and on the other one.
CONFIG_PROVE_LOCKING=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
