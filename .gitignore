# Ignore everything without an extension.
*
!*.*
!*/

# Don't ignore makefiles.
!makefile
!Makefile
!Kbuild

# Don't ignore license files.
!LICENSE
!LICENSE-CONTENT

# Don't ignore the container recipe or the target's init, neither of which has an extension.
!Dockerfile
!init

# Ignore .txt files.
*.txt
!requirements.txt

# kernel/local.config is the reader's own scratch configuration, created in L03's lab. It is
# deliberately not tracked: a course whose config fragments change as people experiment stops
# being able to say what its own numbers were measured with.
kernel/local.config

# Ignore Python cache and the diagrams virtualenv.
*__pycache__/
.venv/

# Ignore vscode directory.
*vscode/
*vs/

# Ignore everything the kernel build leaves behind. A module tree is mostly generated, and the
# only files in lectures/*/lab that belong in git are the ones this repo ships.
*.o
*.ko
*.mod
*.mod.c
*.symvers
*.order
*.cmd
*.o.d
.qa-built-against
.tmp_versions/

# Ignore the build tree: kernel source, images, root filesystems and QEMU. All of it is
# downloaded or generated by ci/, none of it is authored here, and some of it is enormous.
build/
